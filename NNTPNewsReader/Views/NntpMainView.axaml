<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NNTPNewsReader.ViewModels"
             mc:Ignorable="d" 
             d:DesignWidth="800" 
             d:DesignHeight="450"
             x:Class="NNTPNewsReader.Views.NntpMainView"
             x:DataType="vm:NntpMainViewModel"
             Background="DarkMagenta">
    
    
    <Grid
        RowDefinitions="30,*">
    
        <Button
            Grid.Row = "0" 
            Content="Disconnect"
            Command="{Binding Disconnect}">
            
        </Button>
        
        <Grid 
            Grid.Row = "1"
            ColumnDefinitions="250,*"
            RowDefinitions="*,*"
            ShowGridLines="True"
            Margin="10"
            ColumnSpacing="10"
            RowSpacing="5"
            >

        <!--NewsGroups, Remenber to make the ListBox Background="Transparent"  -->
            <Grid
                RowDefinitions="Auto, *"
                Grid.RowSpan="2">
            
                <TextBlock 
                    Grid.Column="0"
                    Grid.Row="0"
                    Text="NewsGroups">
            
                </TextBlock>
            
                <ListBox 
                    Grid.Column="0"
                    Grid.Row="1"
                    Background="Red" 
                    ItemsSource="{Binding NewsGroups}">
            
                </ListBox >
            
            </Grid>
        

            <Grid
                Grid.Row = "0"
                Grid.Column="1"
                RowDefinitions="Auto, *">
            
                <TextBlock 
                    Grid.Column="0"
                    Grid.Row="0"
                    Text="Articles">
            
                </TextBlock>
            
                <ListBox 
                    Grid.Column="0"
                    Grid.Row="1"
                    Background="blue"
                    ItemsSource="{Binding }">
                
                </ListBox >
            
            </Grid>
        
            <Grid
                Grid.Row = "1"
                Grid.Column="1"
                RowDefinitions="Auto, *">
                
                <TextBlock 
                    Grid.Column="0"
                    Grid.Row="0"
                    Text="Content">
                
                </TextBlock>
                
                <ListBox 
                    Grid.Column="0"
                    Grid.Row="1"
                    Background="GreenYellow"
                    ItemsSource="{Binding }">
                
                </ListBox >
                
            </Grid>
        
        </Grid>
    </Grid>
    
</UserControl>
