<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NNTPNewsReader.ViewModels"
             xmlns:models="clr-namespace:NNTPNewsReader.Models"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="NNTPNewsReader.Views.NntpMainView"
             x:DataType="vm:NntpMainViewModel"
             Background="DarkMagenta">

    <!-- the {Binding !SendPostCommand.IsRunning} is added so that user does not do anything while the post is send
    as the post runs on the same tcpClient connection as all other calls -->
    <Grid
        RowDefinitions="30,*"
        Margin="10"
        IsEnabled="{Binding !SendPostCommand.IsRunning}"
        >

        <Border
            Grid.Row="0"
            CornerRadius="5"
            Background="Chartreuse">
            
            <Grid
            
                ColumnDefinitions="*,Auto">
                

                <Label
                    Grid.Column="0"
                    Content="{Binding ErrorMessage}"
                    FontWeight="Bold"
                    FontSize="20"
                    Foreground="Red">
                </Label>
                
                <Button
                    Grid.Column="1"
                    Content="Disconnect"
                    FontSize="10"
                    FontWeight="Bold"
                    Command="{Binding DisconnectCommand}"
                    HorizontalAlignment="Right">
                </Button>


            </Grid>
            
        </Border>
        


        <Grid
            Grid.Row="1"
            ColumnDefinitions="0.5*,*"
            RowDefinitions="*,*"
            ShowGridLines="True"
            ColumnSpacing="10"
            RowSpacing="5">

            <!--NewsGroups, Remenber to make the ListBox Background="Transparent"  -->
            <Border
                Grid.Row="0"
                Grid.Column="0"
                Grid.RowSpan="2"
                Background="Red"
                Padding="10"
                CornerRadius="10">

                <Grid
                    RowDefinitions="Auto, Auto *">

                    <Label
                        Grid.Column="0"
                        Grid.Row="0"
                        Content="NewsGroups"
                        FontWeight="Bold">

                    </Label>

                    <TextBox
                        Grid.Row="1"
                        PlaceholderText="Search for newsgroup"
                        Text="{Binding NewsGroupSearchText, Mode=TwoWay}">
                    </TextBox>

                    <TableView 
                        Grid.Row="2"
                        ItemsSource="{Binding NewsGroups}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedNewsGroupEntry, Mode=TwoWay}"
                        CornerRadius="5"
                        IsEnabled="{Binding !LoadArticlesCommand.IsRunning}"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Background="#2B2B2B">

                        <TableView.Columns>
                            <TableViewColumn Header="Name"
                                             Binding="{Binding GroupName}"
                                             Width="2*" />

                            <TableViewColumn Header="Articles"
                                             Binding="{Binding EstimatedArticles}"
                                             Width="*"
                                             HorizontalContentAlignment="Right" />

                            <TableViewColumn Header="CanPost"
                                             Binding="{Binding Status}"
                                             Width="*"
                                             HorizontalContentAlignment="Right" />
                        </TableView.Columns>
                    </TableView>

                </Grid>

            </Border>


            <Border
                Grid.Row="0"
                Grid.Column="1"
                Background="blue"
                CornerRadius="10"
                Padding="10">
                <Grid
                    RowDefinitions="Auto, Auto, *">

                    <Label
                        Grid.Column="0"
                        Grid.Row="0"
                        Content="Articles"
                        FontWeight="Bold">

                    </Label>
                    
                    <TextBox
                        Grid.Row="1"
                        PlaceholderText="Search for subject"
                        Text="{Binding ArticleSearchText, Mode=TwoWay}">
                    </TextBox>

                    <TableView 
                        Grid.Row="2"
                        ItemsSource="{Binding Articles}"
                        CornerRadius="5"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectedItem="{Binding SelectedArticleEntry, Mode=TwoWay}"
                        SelectionMode="Single"
                        Background="#2B2B2B">

                        <TableView.Columns>
                            <TableViewColumn Header="Subject"
                                             Binding="{Binding ArticleSubject}"
                                             Width="2*" />

                            <TableViewColumn Header="Author"
                                             Binding="{Binding ArticleAuthor}"
                                             Width="*"
                                             HorizontalContentAlignment="Right" />

                            <TableViewColumn Header="Date"
                                             Binding="{Binding ArticleDate}"
                                             Width="*"
                                             HorizontalContentAlignment="Right" />
                        </TableView.Columns>
                    </TableView>

                </Grid>
                
            </Border>
            

            <Border
                Grid.Row="1"
                Grid.Column="1"
                Background="DarkSlateGray"
                CornerRadius="10"
                Padding="10"
                IsVisible="{Binding !IsPosting}">
                
                <Grid
                    RowDefinitions="Auto, *"
                    RowSpacing="8">

                    <Grid
                        Grid.Row = "0"
                        Grid.Column="0"
                        
                        ColumnDefinitions="*, Auto">
                        
                        <Label
                            Grid.Column="0"
                            Content="Content"
                            FontWeight="Bold">

                        </Label>
                        
                        <Button
                            Grid.Column="1"
                            Content="Make Post"
                            Command="{Binding MakePostCommand}"
                            IsEnabled="{Binding CanPostToSelectedGroup}">
                        </Button>
                        
                    </Grid>
                    
                    <Border
                        Grid.Column="0"
                        Grid.Row="1"
                        Background="#2B2B2B"
                        CornerRadius="5"
                        Padding="10">
                        <TextBlock
                            Text="{Binding ArticleBody}"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        </TextBlock>
                        
                    </Border>
                </Grid>
            </Border>
            
            <Border 
                Grid.Row="1"
                Grid.Column="1"
                Padding="10"
                Background="DarkOliveGreen"
                CornerRadius="10"
                IsVisible="{Binding IsPosting}">

                <Grid 
                    RowDefinitions="Auto,*" 
                    RowSpacing="8">

                    <Grid 
                        Grid.Row="0" 
                        ColumnDefinitions="*,*,Auto,Auto">
                        
                        <Label 
                            Content="New post at: " 
                            FontWeight="Bold">
                            
                        </Label>
                        
                        <Label
                            Grid.Column="1"
                            FontWeight="Bold"
                            Content="{Binding PostGroupName}">
                            
                        </Label>

                        <Button 
                            Grid.Column="2"
                            Content="Send"
                            Command="{Binding SendPostCommand}">
                            
                        </Button>
                        
                        <Button 
                            Grid.Column="3"
                            Content="Cancel"
                            Command="{Binding CancelPostCommand}">
                            
                        </Button>
                        
                    </Grid>

                    <Grid 
                        Grid.Row="1"
                        RowDefinitions="Auto,*"
                        ColumnDefinitions="*,*,*"
                        RowSpacing="8"
                        ColumnSpacing="8">

                        <TextBox Grid.Row="0" Grid.Column="0"
                                 PlaceholderText="Name"
                                 Text="{Binding PostAuthor, Mode=TwoWay}" />

                        <TextBox Grid.Row="0" Grid.Column="1"
                                 PlaceholderText="Email"
                                 Text="{Binding PostEmail, Mode=TwoWay}" />

                        <TextBox Grid.Row="0" Grid.Column="2"
                                 PlaceholderText="Subject"
                                 Text="{Binding PostSubject, Mode=TwoWay}" />

                        <TextBox 
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            PlaceholderText="Your message"
                            Text="{Binding PostBody, Mode=TwoWay}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />

                    </Grid>
                </Grid>
            </Border>
           

        </Grid>
    </Grid>

</UserControl>