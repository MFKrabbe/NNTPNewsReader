<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NNTPNewsReader.ViewModels"
             xmlns:models="clr-namespace:NNTPNewsReader.Models"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="NNTPNewsReader.Views.NntpMainView"
             x:DataType="vm:NntpMainViewModel"
             Background="DarkMagenta">


    <Grid
        RowDefinitions="30,*"
        Margin="10">

        <Border
            Grid.Row="0"
            CornerRadius="5"
            Background="Chartreuse">
            
            <Grid
            
                ColumnDefinitions="0.5*,*">

                <Button
                    Grid.Column="0"
                    Content="Disconnect"
                    Command="{Binding DisconnectCommand}">
                </Button>

                <Label
                    Grid.Column="1"
                    Content="{Binding ErrorMessage}"
                    FontWeight="Bold"
                    FontSize="20"
                    Foreground="Red">
                </Label>


            </Grid>
            
        </Border>
        


        <Grid
            Grid.Row="1"
            ColumnDefinitions="0.5*,*"
            RowDefinitions="*,*"
            ShowGridLines="True"
            ColumnSpacing="10"
            RowSpacing="5">

            <!--NewsGroups, Remenber to make the ListBox Background="Transparent"  -->
            <Border
                Grid.Row="0"
                Grid.Column="0"
                Grid.RowSpan="2"
                Background="Red"
                Padding="10"
                CornerRadius="10">

                <Grid
                    RowDefinitions="Auto, Auto *">

                    <Label
                        Grid.Column="0"
                        Grid.Row="0"
                        Content="NewsGroups"
                        FontWeight="Bold">

                    </Label>

                    <TextBox
                        Grid.Row="1"
                        PlaceholderText="Search for newsgroup"
                        Text="{Binding NewsGroupSearchText, Mode=TwoWay}">
                    </TextBox>

                    <TableView 
                        Grid.Row="2"
                        ItemsSource="{Binding NewsGroups}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedNewsGroupEntry, Mode=TwoWay}"
                        CornerRadius="5"
                        IsEnabled="{Binding !LoadArticlesCommand.IsRunning}"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Background="#2B2B2B">

                        <TableView.Columns>
                            <TableViewColumn Header="Name"
                                             Binding="{Binding GroupName}"
                                             Width="2*" />

                            <TableViewColumn Header="Articles"
                                             Binding="{Binding EstimatedArticles}"
                                             Width="*"
                                             HorizontalContentAlignment="Right" />

                            <TableViewColumn Header="CanPost"
                                             Binding="{Binding Status}"
                                             Width="*"
                                             HorizontalContentAlignment="Right" />
                        </TableView.Columns>
                    </TableView>

                </Grid>

            </Border>


            <Border
                Grid.Row="0"
                Grid.Column="1"
                Background="blue"
                CornerRadius="10"
                Padding="10">
                <Grid
                    RowDefinitions="Auto, Auto, *">

                    <Label
                        Grid.Column="0"
                        Grid.Row="0"
                        Content="Articles"
                        FontWeight="Bold">

                    </Label>
                    
                    <TextBox
                        Grid.Row="1"
                        PlaceholderText="Search for subject"
                        Text="{Binding ArticleSearchText, Mode=TwoWay}">
                    </TextBox>

                    <TableView 
                        Grid.Row="2"
                        ItemsSource="{Binding Articles}"
                        CornerRadius="5"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectedItem="{Binding SelectedArticleEntry, Mode=TwoWay}"
                        SelectionMode="Single"
                        Background="#2B2B2B">

                        <TableView.Columns>
                            <TableViewColumn Header="Subject"
                                             Binding="{Binding ArticleSubject}"
                                             Width="2*" />

                            <TableViewColumn Header="Author"
                                             Binding="{Binding ArticleAuthor}"
                                             Width="*"
                                             HorizontalContentAlignment="Right" />

                            <TableViewColumn Header="Date"
                                             Binding="{Binding ArticleDate}"
                                             Width="*"
                                             HorizontalContentAlignment="Right" />
                        </TableView.Columns>
                    </TableView>

                </Grid>
                
            </Border>
            

            <Border
                Grid.Row="1"
                Grid.Column="1"
                Background="DarkSlateGray"
                CornerRadius="10"
                Padding="10">
                
                <Grid
                    RowDefinitions="Auto, *">

                    <Label
                        Grid.Column="0"
                        Grid.Row="0"
                        Content="Content"
                        FontWeight="Bold">

                    </Label>

                    <Border
                        Grid.Column="0"
                        Grid.Row="1"
                        Background="#2B2B2B"
                        CornerRadius="5"
                        Padding="10">
                        <TextBlock
                            Text="{Binding ArticleBody}"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        </TextBlock>
                        
                    </Border>
                    

                </Grid>
                
            </Border>
           

        </Grid>
    </Grid>

</UserControl>